# Copy this file to .env. Never commit the real values.
# Keep this file POSIX-shell compatible because prod/deploy.sh loads it.

PUBLIC_URL=https://example.com
DISCORD_URL=https://discord.gg/pPgZqRS5b2
INSTAGRAM_URL=https://www.instagram.com/mmuminecraftsociety/
MINECRAFT_BIND=0.0.0.0
MINECRAFT_PORT=25565
PUID=1000
PGID=1000
TZ=Europe/London

# Generate with: openssl rand -hex 24
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password

# Generate each secret separately with: openssl rand -hex 32
AUTH_CODE_SECRET=replace-with-at-least-32-random-bytes
VELOCITY_API_SECRET=replace-with-at-least-32-random-bytes
VELOCITY_FORWARDING_SECRET=replace-with-at-least-32-random-bytes

RESEND_API_KEY=re_replace_me
RESEND_FROM='MMU Minecraft Society <minecraft@example.com>'

# Leave the Discord values empty to disable the Discord connection.
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=

# These values support running the API and website outside Docker Compose.
COOKIE_SECURE=false
HOST=0.0.0.0
PORT=8080
API_GRPC_HOST=0.0.0.0
API_GRPC_PORT=50051
MOD_GRPC_TARGET=minecraft:50052
DATABASE_URL=./data/app.sqlite
DATABASE_MIGRATIONS_PATH=./drizzle
API_BASE_URL=http://localhost:8080
