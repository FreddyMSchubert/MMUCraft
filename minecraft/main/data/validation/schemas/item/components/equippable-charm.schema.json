{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "components/equippable-charm.schema.json",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"equipmentSlot": {
			"type": "string",
			"enum": [
				"chest",
				"legs",
				"feet"
			]
		},
		"equippableAssetId": {
			"type": "string",
			"pattern": ".*__charm$"
		}
	},
	"required": [
		"equipmentSlot",
		"equippableAssetId"
	]
}