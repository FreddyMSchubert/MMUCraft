			"id": 11,
			"type": "stat",
			"title": "Sniffers Killed",
			"gridPos": { "h": 5, "w": 6, "x": 6, "y": 19 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"expr": "mmucraft_minecraft_stat{category=\"killed\",id=\"minecraft:sniffer\",summary=\"total\"}",
					"instant": true,
					"legendFormat": "Sniffers",
					"refId": "A"
				}
			],
			"fieldConfig": { "defaults": { "decimals": 0, "min": 0 }, "overrides": [] },
			"options": {
				"colorMode": "value",
				"graphMode": "area",
				"justifyMode": "center",
				"orientation": "auto",
				"reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
				"textMode": "value_and_name",
				"wideLayout": true
			}
		},
		{
			"id": 12,
			"type": "stat",
			"title": "Fish Caught (Rolling 24h)",
			"gridPos": { "h": 5, "w": 6, "x": 12, "y": 19 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"expr": "clamp_min(delta(mmucraft_minecraft_stat{category=\"custom\",id=\"minecraft:fish_caught\",summary=\"total\"}[24h]), 0)",
					"instant": true,
					"legendFormat": "Fish",
					"refId": "A"
				}
			],
			"fieldConfig": { "defaults": { "decimals": 0, "min": 0 }, "overrides": [] },
			"options": {
				"colorMode": "value",
				"graphMode": "area",
				"justifyMode": "center",
				"orientation": "auto",
				"reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
				"textMode": "value_and_name",
				"wideLayout": true
			}
		},
		{
			"id": 13,
			"type": "stat",
			"title": "Stone per Diamond Ore",
			"description": "Native stone plus deepslate mined divided by native diamond ores mined. Minecraft's native counter does not distinguish Silk Touch.",
			"gridPos": { "h": 5, "w": 6, "x": 18, "y": 19 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"expr": "sum(mmucraft_minecraft_stat{category=\"mined\",id=~\"minecraft:(stone|deepslate)\",summary=\"total\"}) / clamp_min(sum(mmucraft_minecraft_stat{category=\"mined\",id=~\"minecraft:(diamond_ore|deepslate_diamond_ore)\",summary=\"total\"}), 1)",
					"instant": true,
					"legendFormat": "Ratio",
					"refId": "A"
				}
			],
			"fieldConfig": { "defaults": { "decimals": 1, "min": 0 }, "overrides": [] },
			"options": {
				"colorMode": "value",
				"graphMode": "area",
				"justifyMode": "center",
				"orientation": "auto",
				"reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
				"textMode": "value_and_name",
				"wideLayout": true
			}
		},
