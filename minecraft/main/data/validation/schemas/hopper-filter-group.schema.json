{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "hopper-filter-group.schema.json",
	"title": "Hopper filter group",
	"$defs": {
		"itemId": {
			"type": "string",
			"pattern": "^(?:minecraft|mainmod):[a-z0-9._-]+(?:/[a-z0-9._-]+)*$"
		},
		"minecraftId": {
			"type": "string",
			"pattern": "^minecraft:[a-z0-9._-]+(?:/[a-z0-9._-]+)*$"
		},
		"enchantmentId": {
			"type": "string",
			"pattern": "^[a-z0-9._-]+:[a-z0-9._-]+(?:/[a-z0-9._-]+)*$"
		},
		"itemIds": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"$ref": "#/$defs/itemId"
			}
		},
		"minecraftIds": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"$ref": "#/$defs/minecraftId"
			}
		},
		"enchantmentIds": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"$ref": "#/$defs/enchantmentId"
			}
		},
		"enchantmentNamespaces": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"pattern": "^[a-z0-9._-]+$"
			}
		}
	},
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"name": {
			"type": "string",
			"pattern": "\\S"
		},
		"items": {
			"$ref": "#/$defs/itemIds"
		},
		"potions": {
			"$ref": "#/$defs/minecraftIds"
		},
		"potion_items": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"enum": [
					"minecraft:potion",
					"minecraft:splash_potion",
					"minecraft:lingering_potion"
				]
			}
		},
		"enchantments": {
			"$ref": "#/$defs/enchantmentIds"
		},
		"enchantment_namespaces": {
			"$ref": "#/$defs/enchantmentNamespaces"
		}
	},
	"required": ["name"],
	"dependentRequired": {
		"potion_items": ["potions"]
	},
	"anyOf": [
		{
			"required": ["items"]
		},
		{
			"required": ["potions"]
		},
		{
			"required": ["enchantments"]
		},
		{
			"required": ["enchantment_namespaces"]
		}
	]
}
