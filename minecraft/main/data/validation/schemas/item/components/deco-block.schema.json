{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "components/deco-block.schema.json",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"ground": {
			"type": "boolean"
		},
		"wall": {
			"type": "boolean"
		},
		"ceiling": {
			"type": "boolean"
		},
		"lightLevel": {
			"type": "integer",
			"minimum": 0,
			"maximum": 15
		},
		"gameplayToggle": { "$ref": "./drop-id.schema.json" }
	},
	"required": ["ground", "wall", "ceiling", "lightLevel"],
	"anyOf": [
		{
			"properties": {
				"ground": {
					"const": true
				}
			}
		},
		{
			"properties": {
				"wall": {
					"const": true
				}
			}
		},
		{
			"properties": {
				"ceiling": {
					"const": true
				}
			}
		}
	]
}
