				"minVizWidth": 0,
				"namePlacement": "auto",
				"orientation": "horizontal",
				"reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
				"showUnfilled": true,
				"sizing": "auto",
				"valueMode": "color"
			}
		},
