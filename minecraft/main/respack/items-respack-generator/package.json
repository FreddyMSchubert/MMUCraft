{
	"name": "mmu-resourcepack-generator",
	"version": "1.0.0",
	"private": true,
	"description": "TypeScript generator for the MMU MC Soc server resource pack.",
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"check": "tsc -p tsconfig.json --noEmit",
		"generate": "npm run build && node dist/cli.js"
	},
	"dependencies": {
		"sharp": "^0.35.3"
	},
	"devDependencies": {
		"@types/node": "^22.15.30",
		"typescript": "^5.8.3"
	}
}
