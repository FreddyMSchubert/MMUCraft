		},
		{
			"id": 23,
			"type": "stat",
			"title": "Median Balance",
			"gridPos": { "h": 5, "w": 4, "x": 12, "y": 34 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"expr": "mmucraft_money_dabloons{measure=\"median_balance\"}",
					"instant": true,
					"legendFormat": "Dabloons",
					"refId": "A"
				}
			],
			"fieldConfig": { "defaults": { "decimals": 1, "min": 0 }, "overrides": [] },
			"options": {
				"colorMode": "value",
				"graphMode": "area",
				"justifyMode": "center",
				"orientation": "auto",
				"reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
				"textMode": "value_and_name",
				"wideLayout": true
			}
		},
		{
			"id": 24,
			"type": "stat",
			"title": "7-Day Supply Growth",
			"description": "A money-supply growth proxy, not price inflation. It becomes available after seven days of Prometheus history.",
			"gridPos": { "h": 5, "w": 4, "x": 16, "y": 34 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"expr": "mmucraft_money_dabloons{measure=\"player_supply\"} / clamp_min(mmucraft_money_dabloons{measure=\"player_supply\"} offset 7d, 1) - 1",
					"instant": true,
					"legendFormat": "Growth",
					"refId": "A"
				}
