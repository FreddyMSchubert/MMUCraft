{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "components/equippable-torso-extremities.schema.json",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"equipmentSlot": {
			"type": "string",
			"enum": [
				"chest",
				"legs",
				"feet",
				"mainhand",
				"offhand",
				"body"
			]
		},
		"swappable": {
			"type": "boolean"
		},
		"dispensable": {
			"type": "boolean"
		},
		"damageOnHurt": {
			"type": "boolean"
		}
	},
	"required": [
		"equipmentSlot",
		"swappable",
		"dispensable",
		"damageOnHurt"
	]
}