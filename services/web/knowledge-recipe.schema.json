{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mmuminecraftsociety.co.uk/schemas/knowledge-recipe.json",
  "title": "Knowledge Book Crafting Recipe",
  "description": "A crafting-table recipe embedded in a fenced recipe block on a knowledge page.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "inputs", "output"],
  "properties": {
    "type": {
      "description": "The recipe layout type shown in the widget footer.",
      "enum": ["shaped", "shapeless"]
    },
    "inputs": {
      "description": "The occupied crafting-grid slots. Omit empty slots and use each position only once.",
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": { "$ref": "#/definitions/input" }
    },
    "output": { "$ref": "#/definitions/output" }
  },
  "definitions": {
    "asset": {
      "description": "One item resource ID or PNG URL, or frames that cycle once per second.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "examples": ["minecraft:stick", "mainmod:charm-wallet", "/assets/items/example.png"]
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["src"],
            "properties": {
              "src": { "type": "string", "minLength": 1 },
              "title": {
                "description": "An optional name for this frame. It replaces the general item name while this frame is visible.",
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "links": {
      "type": "object",
      "properties": {
        "wikiUrl": {
          "description": "An external page that opens in a new tab.",
          "type": "string",
          "pattern": "^https?://"
        },
        "knowledgeUrl": {
          "description": "An internal knowledge page that opens in the current tab.",
          "type": "string",
          "pattern": "^/play/knowledge(?:/|$)"
        }
      },
      "not": {
        "type": "object",
        "properties": { "wikiUrl": true, "knowledgeUrl": true },
        "required": ["wikiUrl", "knowledgeUrl"]
      }
    },
    "input": {
      "description": "One occupied cell in the 3 by 3 input grid.",
      "type": "object",
      "additionalProperties": false,
      "required": ["pos", "name", "asset"],
      "properties": {
        "pos": {
          "description": "Top, middle, or bottom row followed by left, middle, or right column. M is the center.",
          "enum": ["TL", "TM", "TR", "ML", "M", "MR", "BL", "BM", "BR"]
        },
        "name": { "type": "string", "minLength": 1 },
        "tooltip": { "type": "string" },
        "asset": { "$ref": "#/definitions/asset" },
        "wikiUrl": true,
        "knowledgeUrl": true
      },
      "allOf": [{ "$ref": "#/definitions/links" }]
    },
    "output": {
      "description": "The item produced by the recipe.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "asset"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "tooltip": { "type": "string" },
        "asset": { "$ref": "#/definitions/asset" },
        "wikiUrl": true,
        "knowledgeUrl": true,
        "count": {
          "description": "The stack count shown at the bottom-right of the output slot.",
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [{ "$ref": "#/definitions/links" }]
    }
  }
}
