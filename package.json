{
	"name": "mmucraft-checks",
	"private": true,
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"scripts": {
		"format": "prettier --write .github/workflows services/api services/web minecraft/main/respack/items-respack-generator",
