limit_req_zone $binary_remote_addr zone=site_per_ip:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=15r/s;
limit_req_status 429;

server {
    listen 8080;
    server_name ${PUBLIC_HOST} www.${PUBLIC_HOST};
    limit_req zone=site_per_ip burst=90 nodelay;
    return 308 https://${PUBLIC_HOST}$request_uri;
}

server {
    listen 8443 ssl;
    server_name www.${PUBLIC_HOST};
    limit_req zone=site_per_ip burst=90 nodelay;

    ssl_certificate /etc/letsencrypt/live/mmucraft/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mmucraft/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 308 https://${PUBLIC_HOST}$request_uri;
}

server {
    listen 8443 ssl;
    server_name ${PUBLIC_HOST};
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/mmucraft/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mmucraft/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 2m;
    keepalive_timeout 20s;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location /api/ {
        limit_req zone=api_per_ip burst=30 nodelay;
        proxy_pass http://api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location /_next/static/ {
        limit_req zone=site_per_ip burst=90 nodelay;
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /packs/ {
        limit_req zone=site_per_ip burst=90 nodelay;
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_buffering off;
    }

    location / {
        limit_req zone=site_per_ip burst=90 nodelay;
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
