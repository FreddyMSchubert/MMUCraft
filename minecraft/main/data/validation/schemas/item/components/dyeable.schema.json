{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "components/dyeable.schema.json",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"tintColor": {
			"oneOf": [
				{
					"type": "string",
					"pattern": "^#?[0-9A-Fa-f]{6}$"
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"r": {
							"type": "integer",
							"minimum": 0,
							"maximum": 255
						},
						"g": {
							"type": "integer",
							"minimum": 0,
							"maximum": 255
						},
						"b": {
							"type": "integer",
							"minimum": 0,
							"maximum": 255
						}
					},
					"required": [
						"r",
						"g",
						"b"
					]
				}
			]
		}
	},
	"required": [
		"tintColor"
	]
}