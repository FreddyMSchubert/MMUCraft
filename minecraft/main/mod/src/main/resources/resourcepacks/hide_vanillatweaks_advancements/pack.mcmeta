{
  "pack": {
    "description": "Hide the Vanilla Tweaks advancement tab",
    "min_format": [
      121,
      0
    ],
    "max_format": [
      121,
      0
    ]
  },
  "filter": {
    "block": [
      {
        "namespace": "^vanillatweaks$",
        "path": "^advancement/.*$"
      }
    ]
  }
}
