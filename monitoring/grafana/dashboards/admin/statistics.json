					"legendFormat": "Blocks",
					"refId": "A"
				}
			],
			"fieldConfig": { "defaults": { "decimals": 0, "min": 0 }, "overrides": [] },
			"options": {
				"colorMode": "value",
				"graphMode": "area",
				"justifyMode": "center",
				"orientation": "auto",
				"reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
				"textMode": "value_and_name",
				"wideLayout": true
			}
		},
		{
			"id": 10,
			"type": "stat",
			"title": "Player Deaths",
			"gridPos": { "h": 5, "w": 6, "x": 0, "y": 19 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"expr": "mmucraft_minecraft_stat{category=\"custom\",id=\"minecraft:deaths\",summary=\"total\"}",
					"instant": true,
					"legendFormat": "Deaths",
