		{
			"id": 22,
			"type": "stat",
			"title": "Returned or Removed",
			"description": "Issued money minus current player balances. Existing data does not distinguish purchases from administrative removal.",
			"gridPos": { "h": 5, "w": 4, "x": 8, "y": 34 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"expr": "mmucraft_money_dabloons{measure=\"returned_or_removed\"}",
