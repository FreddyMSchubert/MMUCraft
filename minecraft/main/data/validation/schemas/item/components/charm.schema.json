{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "components/charm.schema.json",
	"$defs": {
		"charmUpgradeIngredient": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"id": { "type": "string", "minLength": 1 },
				"count": { "type": "integer", "minimum": 1 }
			},
			"required": ["id", "count"]
		},
		"charmLevel": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"level": { "type": "integer", "minimum": 0 },
				"abilityStatusCurrent": { "type": "string", "minLength": 1 },
				"abilityStatusRelative": { "type": "string" },
				"upgradeIngredients": {
					"type": "array",
					"items": { "$ref": "#/$defs/charmUpgradeIngredient" }
				}
			},
			"required": [
				"level",
				"abilityStatusCurrent",
				"abilityStatusRelative",
				"upgradeIngredients"
			]
		}
	},
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"charmId": { "type": "integer" },
		"minLevel": { "type": "integer", "minimum": 0 },
		"maxLevel": { "type": "integer", "minimum": 0 },
		"levels": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/charmLevel" }
		}
	},
	"required": ["charmId", "minLevel", "maxLevel", "levels"]
}
