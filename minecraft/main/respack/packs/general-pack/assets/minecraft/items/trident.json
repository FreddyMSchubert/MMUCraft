{
	"model": {
		"type": "minecraft:select",
		"property": "minecraft:custom_model_data",
		"index": 0,
		"cases": [
			{
				"when": "snowball-machine-gun",
				"model": {
					"type": "minecraft:condition",
					"property": "minecraft:custom_model_data",
					"index": 1,
					"on_true": {
						"type": "minecraft:range_dispatch",
						"property": "minecraft:crossbow/pull",
						"entries": [
							{
								"threshold": 0.58,
								"model": {
									"type": "minecraft:model",
									"model": "general-pack:item/snowball-machine-gun/loading_1"
								}
							},
							{
								"threshold": 1.0,
								"model": {
									"type": "minecraft:model",
									"model": "general-pack:item/snowball-machine-gun/loading_2"
								}
							}
						],
						"fallback": {
							"type": "minecraft:model",
							"model": "general-pack:item/snowball-machine-gun/loading_0"
						}
					},
					"on_false": {
						"type": "minecraft:condition",
						"property": "minecraft:custom_model_data",
						"index": 0,
						"on_false": {
							"type": "minecraft:model",
							"model": "general-pack:item/snowball-machine-gun/idle"
						},
						"on_true": {
							"type": "minecraft:condition",
							"property": "minecraft:using_item",
							"on_true": {
								"type": "minecraft:model",
								"model": "general-pack:item/snowball-machine-gun/firing"
							},
							"on_false": {
								"type": "minecraft:model",
								"model": "general-pack:item/snowball-machine-gun/loaded"
							}
						}
					}
				}
			}
		],
		"fallback": {
			"type": "minecraft:select",
			"property": "minecraft:display_context",
			"cases": [
				{
					"when": ["gui", "ground", "fixed", "on_shelf"],
					"model": { "type": "minecraft:model", "model": "minecraft:item/trident" }
				}
			],
			"fallback": {
				"type": "minecraft:condition",
				"property": "minecraft:using_item",
				"on_false": {
					"type": "minecraft:special",
					"base": "minecraft:item/trident_in_hand",
					"model": { "type": "minecraft:trident" }
				},
				"on_true": {
					"type": "minecraft:special",
					"base": "minecraft:item/trident_throwing",
					"model": { "type": "minecraft:trident" }
				},
				"transformation": {
					"left_rotation": [0.0, 0.0, 0.0, 1.0],
					"right_rotation": [0.0, 0.0, 0.0, 1.0],
					"scale": [1.0, -1.0, -1.0],
					"translation": [0.0, 0.0, 0.0]
				}
			}
		}
