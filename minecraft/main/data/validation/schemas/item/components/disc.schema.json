{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "components/disc.schema.json",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"songId": {
			"type": "string",
			"pattern": "^[a-z0-9._-]+:[a-z0-9._-]+(?:/[a-z0-9._-]+)*$"
		}
	},
	"required": [
		"songId"
	]
}
