	"refresh": "15s",
	"schemaVersion": 42,
	"tags": ["statistics", "minecraft", "mmucraft"],
	"templating": {
		"list": [
			{
				"name": "category",
				"label": "Stat group",
				"type": "query",
				"datasource": { "type": "prometheus", "uid": "prometheus" },
				"query": {
					"query": "label_values(mmucraft_minecraft_stat, category)",
					"refId": "PrometheusVariableQueryEditor-Category"
				},
				"definition": "label_values(mmucraft_minecraft_stat, category)",
				"current": { "text": "custom", "value": "custom" },
				"refresh": 1,
				"sort": 1
			},
			{
				"name": "stat",
				"label": "Minecraft stat",
				"type": "query",
				"datasource": { "type": "prometheus", "uid": "prometheus" },
				"query": {
					"query": "label_values(mmucraft_minecraft_stat{category=\"$category\"}, id)",
					"refId": "PrometheusVariableQueryEditor-Stat"
				},
				"definition": "label_values(mmucraft_minecraft_stat{category=\"$category\"}, id)",
				"current": { "text": "minecraft:deaths", "value": "minecraft:deaths" },
				"refresh": 1,
				"sort": 1
			}
		]
	},
	"time": { "from": "now-7d", "to": "now" },
	"timepicker": {},
	"timezone": "browser",
	"title": "MMUCraft Statistics",
	"uid": "mmucraft-statistics",
	"version": 1
