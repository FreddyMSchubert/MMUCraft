{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "components/shop-purchasable.schema.json",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"membersOnly": { "type": "boolean" },
		"gameplayToggle": { "type": "string", "pattern": "^[a-z0-9._-]+(?:/[a-z0-9._-]+)*$" },
		"priceDabloons": { "type": "integer", "minimum": 1 },
		"description": { "type": "string" },
		"unlockMessage": { "type": "string", "minLength": 1 },
		"unlockWeight": { "type": "integer", "minimum": 1 },
		"tags": {
			"type": "array",
			"items": { "type": "string", "minLength": 1 },
			"uniqueItems": true
		}
	},
	"required": ["membersOnly", "priceDabloons", "unlockWeight"]
}
