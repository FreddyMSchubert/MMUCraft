{
	"name": "mcstack-api",
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"scripts": {
		"dev": "tsc-watch -p tsconfig.json --onSuccess \"node --env-file-if-exists=.env dist/main.js\"",
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:check": "drizzle-kit check",
		"db:studio": "drizzle-kit studio --host 0.0.0.0 --port 4983",
		"start": "node --env-file-if-exists=.env dist/main.js",
		"prod": "npm run build && npm run start"
	},
	"dependencies": {
		"@grpc/grpc-js": "^1.14.0",
		"@grpc/proto-loader": "^0.8.0",
		"@nestjs/common": "^11.1.18",
		"@nestjs/core": "^11.1.18",
		"@nestjs/platform-fastify": "^11.0.20",
		"better-sqlite3": "^12.8.0",
		"discord.js": "^14.27.0",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.11.3",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"sharp": "^0.35.3"
	},
	"overrides": {
		"esbuild": "^0.25.12",
		"find-my-way": "9.7.0"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24.12.2",
		"drizzle-kit": "^0.31.10",
		"tsc-watch": "^7.2.0",
		"typescript": "^5.9.3"
	}
}
