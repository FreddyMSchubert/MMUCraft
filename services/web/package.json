{
	"name": "mcstack-web",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "npm run validate:recipes && next build",
		"start": "next start",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"validate:recipes": "node scripts/validate-knowledge-recipes.mjs",
		"check": "npm run lint && npm run typecheck && npm run build",
		"audit:prod": "npm audit --omit=dev --audit-level=high"
	},
	"dependencies": {
		"@formkit/auto-animate": "^0.10.0",
		"fireworks-js": "^2.10.8",
		"marked": "^18.0.4",
		"next": "^16.1.6",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"sharp": "^0.34.5",
		"three": "^0.170.0"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@types/three": "^0.170.0",
		"ajv": "^8.17.1",
		"eslint": "^9.0.0",
		"eslint-config-next": "^16.1.6",
		"typescript": "^5.9.3"
	}
}
