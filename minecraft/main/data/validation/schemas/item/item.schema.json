{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "item.schema.json",
	"title": "Composable fake item",
	"$defs": {
		"resourceIdentifier": {
			"type": "string",
			"pattern": "^[a-z0-9._-]+(?:/[a-z0-9._-]+)*$"
		},
		"namespacedResourceIdentifier": {
			"type": "string",
			"pattern": "^[a-z0-9._-]+:[a-z0-9._-]+(?:/[a-z0-9._-]+)*$"
		}
	},
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"title": {
			"type": "string",
			"minLength": 1
		},
		"id": {
			"$ref": "#/$defs/resourceIdentifier"
		},
		"baseItemOverride": {
			"$ref": "#/$defs/namespacedResourceIdentifier"
		},
		"modelType": {
			"type": "string",
			"enum": ["basic", "basic-3d", "charm", "cosmetic"]
		},
		"rarity": {
			"type": "string",
			"enum": ["common", "uncommon", "rare", "epic", "legendary", "mythical"]
		},
		"maxStackSize": {
			"oneOf": [
				{
					"type": "integer",
					"minimum": 1,
					"maximum": 99
				}
			]
		},
		"fireproof": {
			"type": "boolean"
		},
		"tooltips": {
			"type": "array",
			"items": {
				"type": "string"
			}
		},
		"shopPurchasable": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"priceDabloons": {
					"type": "integer",
					"minimum": 1
				},
				"description": {
					"type": "string"
				},
				"unlockMessage": {
					"type": "string",
					"minLength": 1
				},
				"unlockWeight": {
					"type": "integer",
					"minimum": 1
				},
				"tags": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"uniqueItems": true
				}
			},
			"required": ["priceDabloons", "unlockWeight"]
		},
		"charm": {
			"$ref": "./components/charm.schema.json"
		},
		"consumable": {
			"$ref": "./components/consumable.schema.json"
		},
		"dyeable": {
			"$ref": "./components/dyeable.schema.json"
		},
		"decoBlock": {
			"$ref": "./components/deco-block.schema.json"
		},
		"equippableCharm": {
			"$ref": "./components/equippable-charm.schema.json"
		},
		"equippableCosmetic": {
			"$ref": "./components/equippable-cosmetic.schema.json"
		},
		"disc": {
			"$ref": "./components/disc.schema.json"
		},
		"fish": {
			"$ref": "./components/fish.schema.json"
		}
	},
	"required": ["title", "id", "modelType", "rarity", "maxStackSize", "tooltips"],
	"allOf": [
		{
			"if": {
				"required": ["equippableCosmetic"]
			},
			"then": {
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^cosmetic-"
					}
				}
			}
		},
		{
			"if": {
				"required": ["fish"]
			},
			"then": {
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^fish-"
					}
				}
			}
		},
		{
			"if": {
				"required": ["charm"]
			},
			"then": {
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^(?:charm|cosmetic)-"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"modelType": {
						"const": "charm"
					}
				},
				"required": ["modelType"]
			},
			"then": {
				"required": ["equippableCharm"]
			}
		},
		{
			"if": {
				"properties": {
					"modelType": {
						"const": "cosmetic"
					}
				},
				"required": ["modelType"]
			},
			"then": {
				"required": ["equippableCosmetic"]
			}
		},
		{
			"not": {
				"required": ["equippableCharm", "equippableCosmetic"]
			}
		}
	]
}
