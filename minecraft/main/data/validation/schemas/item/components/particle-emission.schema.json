{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "components/particle-emission.schema.json",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"particles": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"particle": {
						"type": "string",
						"pattern": "^[a-z0-9._-]+:[a-z0-9._-]+(?:/[a-z0-9._-]+)*$"
					},
					"from": { "$ref": "#/$defs/point" },
					"to": { "$ref": "#/$defs/point" },
					"minTicks": { "type": "integer", "minimum": 1, "maximum": 12000 },
					"maxTicks": { "type": "integer", "minimum": 1, "maximum": 12000 },
					"color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
					"scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 4 },
					"arguments": { "type": "string", "minLength": 1, "maxLength": 512 }
				},
				"required": ["particle", "from", "to", "minTicks", "maxTicks"],
				"allOf": [
					{ "not": { "required": ["arguments", "color"] } },
					{ "not": { "required": ["arguments", "scale"] } },
					{
						"if": { "properties": { "particle": { "const": "minecraft:dust" } } },
						"else": {
							"not": {
								"anyOf": [{ "required": ["color"] }, { "required": ["scale"] }]
							}
						}
					}
				]
			}
		}
	},
	"required": ["particles"],
	"$defs": {
		"point": {
			"type": "array",
			"prefixItems": [
				{ "type": "number", "minimum": -64, "maximum": 64 },
				{ "type": "number", "minimum": -64, "maximum": 64 },
				{ "type": "number", "minimum": -64, "maximum": 64 }
			],
			"items": false,
			"minItems": 3
		}
	}
}
