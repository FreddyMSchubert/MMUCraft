{
	"name": "mcstack-web",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"scripts": {
		"dev": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next dev --turbopack",
		"build": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next build",
		"start": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next start",
		"lint": "eslint . --max-warnings=0",
		"typecheck": "tsc --noEmit",
		"check": "npm run lint && npm run typecheck",
		"audit:prod": "npm audit --omit=dev --audit-level=high"
	},
	"dependencies": {
		"@formkit/auto-animate": "^0.10.0",
		"fireworks-js": "^2.10.8",
		"marked": "^18.0.4",
		"next": "^16.3.2",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"sharp": "^0.35.3",
		"three": "^0.170.0",
		"word-list": "^4.1.0"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@types/three": "^0.170.0",
		"eslint": "^9.0.0",
		"eslint-config-next": "^16.1.6",
		"typescript": "^5.9.3"
	}
}
