# Keep this file POSIX-shell compatible because deploy.sh loads it.
PUBLIC_URL=https://example.com
DISCORD_URL=https://discord.gg/pPgZqRS5b2
INSTAGRAM_URL=https://www.instagram.com/mmuminecraftsociety/
MINECRAFT_BIND=0.0.0.0
MINECRAFT_PORT=25565
PUID=1000
PGID=1000
TZ=Europe/London

# Generate with: openssl rand -hex 24
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password

# Generate with: openssl rand -hex 32
AUTH_CODE_SECRET=replace-with-at-least-32-random-bytes
VELOCITY_API_SECRET=replace-with-at-least-32-random-bytes
VELOCITY_FORWARDING_SECRET=replace-with-at-least-32-random-bytes
RESEND_API_KEY=re_replace_me
RESEND_FROM='MMU Minecraft Society <minecraft@example.com>'

# discord conn
DISCORD_BOT_TOKEN=replace-me
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace-me
DISCORD_CHANNEL_ID=replace-me
DISCORD_GUILD_ID=replace-me
