				"justifyMode": "center",
				"orientation": "auto",
				"reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
				"textMode": "value_and_name",
				"wideLayout": true
			}
		},
		{
			"id": 21,
			"type": "stat",
			"title": "Money Issued Ever",
			"gridPos": { "h": 5, "w": 4, "x": 4, "y": 34 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"expr": "mmucraft_money_dabloons{measure=\"issued\"}",
					"instant": true,
					"legendFormat": "Dabloons",
					"refId": "A"
				}
			],
			"fieldConfig": { "defaults": { "decimals": 0, "min": 0 }, "overrides": [] },
			"options": {
				"colorMode": "value",
