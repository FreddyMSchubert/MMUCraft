{
	"annotations": { "list": [] },
	"editable": false,
	"graphTooltip": 1,
	"panels": [
		{
			"id": 1,
			"type": "stat",
			"title": "Players Online Now",
			"description": "Players connected to the Minecraft server right now.",
			"gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"expr": "mainmod_online_players",
					"instant": true,
					"legendFormat": "Online",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"color": { "mode": "fixed", "fixedColor": "green" },
					"decimals": 0,
					"min": 0,
					"noValue": "Offline"
				},
				"overrides": []
			},
			"options": {
				"colorMode": "background",
				"graphMode": "area",
				"justifyMode": "center",
				"orientation": "auto",
				"reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
				"textMode": "value_and_name",
				"wideLayout": true
			}
		},
		{
			"id": 2,
			"type": "stat",
			"title": "All-Time Concurrent Record",
			"gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"expr": "mainmod_peak_online_players",
					"instant": true,
					"legendFormat": "Players",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": { "decimals": 0, "min": 0, "noValue": "No data" },
				"overrides": []
			},
			"options": {
				"colorMode": "value",
				"graphMode": "area",
				"justifyMode": "center",
				"orientation": "auto",
				"reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
				"textMode": "value_and_name",
				"wideLayout": true
			}
		},
		{
			"id": 3,
			"type": "stat",
			"title": "Players Signed Up",
			"gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"expr": "mmucraft_users",
					"instant": true,
					"legendFormat": "Players",
					"refId": "A"
				}
			],
			"fieldConfig": { "defaults": { "decimals": 0, "min": 0 }, "overrides": [] },
			"options": {
				"colorMode": "value",
				"graphMode": "area",
				"justifyMode": "center",
				"orientation": "auto",
				"reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
				"textMode": "value_and_name",
				"wideLayout": true
			}
		},
		{
			"id": 4,
			"type": "stat",
			"title": "Total Hours Played",
			"gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"expr": "mmucraft_player_play_seconds{measure=\"total\"} / 3600",
					"instant": true,
					"legendFormat": "Hours",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": { "decimals": 1, "min": 0, "unit": "h" },
				"overrides": []
			},
			"options": {
				"colorMode": "value",
				"graphMode": "area",
				"justifyMode": "center",
				"orientation": "auto",
				"reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
				"textMode": "value_and_name",
				"wideLayout": true
			}
		},
		{
			"id": 5,
			"type": "timeseries",
			"title": "Concurrent Players",
			"description": "Prometheus builds this history from five-second MainMod samples.",
			"gridPos": { "h": 9, "w": 24, "x": 0, "y": 5 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{ "expr": "mainmod_online_players", "legendFormat": "Online players", "refId": "A" }
			],
			"fieldConfig": {
				"defaults": {
					"decimals": 0,
					"min": 0,
					"custom": {
						"drawStyle": "line",
						"fillOpacity": 25,
						"lineInterpolation": "smooth",
						"lineWidth": 2,
						"showPoints": "never",
						"spanNulls": false
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"calcs": ["max", "mean"],
					"displayMode": "list",
					"placement": "bottom",
					"showLegend": true
				},
				"tooltip": { "mode": "single", "sort": "none" }
			}
		},
		{
			"id": 6,
			"type": "stat",
			"title": "Minecart Distance",
			"description": "Total native minecart distance across every synced player.",
			"gridPos": { "h": 5, "w": 6, "x": 6, "y": 14 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"expr": "mmucraft_minecart_distance_meters",
					"instant": true,
					"legendFormat": "Minecart travel",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": { "decimals": 1, "min": 0, "unit": "lengthm" },
				"overrides": []
			},
			"options": {
				"colorMode": "value",
				"graphMode": "area",
				"justifyMode": "center",
				"orientation": "auto",
				"reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
				"textMode": "value_and_name",
				"wideLayout": true
			}
		},
		{
			"id": 7,
			"type": "stat",
			"title": "Minecart Distance Is About...",
			"description": "The minecart distance shown immediately to the left, expressed using a nearby comparison unit.",
			"gridPos": { "h": 5, "w": 6, "x": 12, "y": 14 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"expr": "mmucraft_minecart_distance_comparison",
					"instant": true,
					"legendFormat": "{{unit}}",
					"refId": "A"
				}
			],
			"fieldConfig": { "defaults": { "decimals": 1, "min": 0 }, "overrides": [] },
			"options": {
				"colorMode": "value",
				"graphMode": "none",
				"justifyMode": "center",
				"orientation": "auto",
				"reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
				"textMode": "value_and_name",
				"wideLayout": true
			}
		},
		{
			"id": 8,
			"type": "stat",
			"title": "Total Travel — All Players, All Time",
			"description": "Sum of all native movement counters across every synced player, including travel by foot, water, air, and vehicles. Normal teleports do not increase them.",
			"gridPos": { "h": 5, "w": 6, "x": 0, "y": 14 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"expr": "sum(mmucraft_minecraft_stat{category=\"custom\",id=~\"minecraft:.*_one_cm\",summary=\"total\"}) / 100",
					"instant": true,
					"legendFormat": "Travel",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": { "decimals": 1, "min": 0, "unit": "lengthm" },
				"overrides": []
			},
			"options": {
				"colorMode": "value",
				"graphMode": "area",
				"justifyMode": "center",
				"orientation": "auto",
				"reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
				"textMode": "value_and_name",
				"wideLayout": true
			}
		},
		{
			"id": 9,
			"type": "stat",
			"title": "Ancient Debris Mined",
			"gridPos": { "h": 5, "w": 6, "x": 18, "y": 14 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"expr": "mmucraft_minecraft_stat{category=\"mined\",id=\"minecraft:ancient_debris\",summary=\"total\"}",
