# Copy this file to .env. Never commit the real values.
RESEND_API_KEY=re_replace_me
# Do not quote this value; Docker Compose imports .env values literally.
RESEND_FROM=MMU Minecraft Society <noreply@your-verified-domain.example>

AUTH_CODE_SECRET=replace-with-a-long-random-secret
# Use true only when the website is served over HTTPS.
COOKIE_SECURE=false
HOST=0.0.0.0
PORT=8080
API_GRPC_HOST=0.0.0.0
API_GRPC_PORT=50051
MOD_GRPC_TARGET=minecraft:50052

DATABASE_URL=./data/app.sqlite
DATABASE_MIGRATIONS_PATH=./drizzle
